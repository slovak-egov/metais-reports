":"IBM"},{"name":"Gen_Profil_ref_id","value":"https://data.gov.sk/id/ikt/storage/12"},{"name":"IKT_Migracia_TP_Ulozisko_celkova_pouzitelna_kapacita","value":"32,7TB"}],"metaAttributes":{"owner":"d52ceba5-528c-4480-8275-f7ab675ac2d1-d5e4b6f4-f103-44f1-b588-9db280e7d850","state":"DRAFT","createdBy":"erich.neuschel","createdAt":"2017-11-27T11:06:50.907","lastModifiedBy":"erich.neuschel","lastModifiedAt":"2017-11-27T15:09:39.675"}},{"type":"TP_Ulozisko","uuid":"bc111c96-0ea7-471e-a039-b3538e8dccd8","attributes":[{"name":"Gen_Profil_anglicky_nazov","value":"SUN STORAGETEK 9990V"},{"name":"Gen_Profil_poznamka","value":"•4th generation, highly reliable, high-performance crossbar architecture\n•106 GB/sec internal data bandwidth and 3.5M IOPS\n•Up to 247 PB of virtualized storage and up to 1,134.5 TB of internal capacity\n•Number of disks (with spares): 5 to 1,152\n•Hot spares: 16 maximum\n•Drive types 73 GB 15K; 146 GB 15K/10K; 300 GB 10K\n•RAID Levels 1, 1+0, 5, 6\n•Up to 224 Fibre Channel and 112 FICON/ESCON host ports\n•Up to 32 virtual partitions"},{"name":"Gen_Profil_kod_metais","value":"tp_ulozisko_15"},{"name":"IKT_Profil_TP_Ulozisko_redundancia","value":"1"},{"name":"IKT_Profil_TP_Ulozisko_spotrebovana_kapacita","value":49.0},{"name":"IKT_Profil_TP_Ulozisko_sposob_pripojenia","value":"FC"},{"name":"Gen_Profil_EA_zoznam_referencii","value":[]},{"name":"IKT_Profil_TP_Ulozisko_celkova_kapacita","value":55.0},{"name":"Gen_Profil_zdroj","value":"c_zdroj.1"},{"name":"Gen_Profil_popis","value":"rovnaké zariadenia sú umiestnené v DC BA a Tajov"},{"name":"Gen_Profil_nazov","value":"SUN STORAGETEK 9990V"},{"name":"IKT_Profil_TP_priznak_schvalenia","value":false},{"name":"IKT_Profil_TP_Ulozisko_rocny_prirastok","value":15.0},{"name":"IKT_Profil_TP_rok_ukoncenia_zivotnosti","value":"09/30/2016"},{"name":"Gen_Profil_anglicky_popis","value":"The Sun StorageTek 9990V Disk Array delivers enterprise-class functionality, integrated storage virtualization, thin provisioning, logical partitioning, and universal replication. The STK 9990V’s fourth-generation crossbar switch architecture delivers high performance and reliability. With no single point of failure, instant data access, fault-tolerant critical and redundant components, “call-home” capability, and data cache mirroring, the StorageTek 9990V ensures non-disruptive service and 24×7 data protection. The 9990V offers massive scalability and supports all major open and mainframe systems. It is compatible with multiple protocols, including 224 Fibre Channel, 112 FICON, 112 ESCON port, and future NAS support. The StorageTek 9990V’s powerful suite of software tools ensures your system keeps your business up and running with total availability."},{"name":"IKT_Profil_TP_vyrobca","value":"Oracle"},{"name":"IKT_Profil_TP_pocet","value":2},{"name":"Gen_Profil_ref_id","value":"https://data.gov.sk/id/ikt/storage/15"}],"metaAttributes":{"owner":"d52ceba5-528c-4480-8275-f7ab675ac2d1-d5e4b6f4-f103-44f1-b588-9db280e7d850","state":"DRAFT","createdBy":"slompart@MF.MFSR.SK","createdAt":"2018-03-15T15:09:08.203","lastModifiedBy":"slompart@MF.MFSR.SK","lastModifiedAt":"2018-03-15T15:09:08.203"}},{"type":"TP_Ulozisko","uuid":"6afd2cb6-bfad-441c-8622-c89bb84462f3","attributes":[{"name":"Gen_Profil_anglicky_nazov","value":"Storage provided by DataCentrum( Cintorínska, Bratislava )"},{"name":"Gen_Profil_kod_metais","value":"tp_ulozisko_17"},{"name":"Gen_Profil_EA_zoznam_referencii","value":[]},{"name":"Gen_Profil_zdroj","value":"c_zdroj.1"},{"name":"Gen_Profil_nazov","value":"Úložisko poskytované DataCentrum( Cintorínska, Bratislava )"},{"name":"IKT_Profil_TP_priznak_schvalenia","value":false},{"name":"Gen_Profil_ref_id","value":"https://data.gov.sk/id/ikt/storage/17"}],"metaAttributes":{"owner":"d52ceba5-528c-4480-8275-f7ab675ac2d1-d5e4b6f4-f103-44f1-b588-9db280e7d850","state":"DRAFT","createdBy":"ivan.miniarik","createdAt":"2018-03-21T10:17:54.320","lastModifiedBy":"ivan.miniarik","lastModifiedAt":"2018-03-21T10