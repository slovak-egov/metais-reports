METAIS_BASE=https://metais.slovensko.sk

CITYPES_URL=$METAIS_BASE/api/types-repo/citypes/list
CITYPES_DETAIL_URL=$METAIS_BASE/api/types-repo/citypes/citype

RELTYPES_URL=$METAIS_BASE/api/types-repo/relationshiptypes/list
RELTYPES_DETAIL_URL=$METAIS_BASE/api/types-repo/relationshiptypes/relationshiptype

CONNECTION_MAX_RETRIES=5
CONNECTION_RETRY_DELAY=0.5

NODE_PAGE_SIZE=1000
REL_PAGE_SIZE=32768

METAIS_RAW_ROOT=output
META_VIZ_DATA_ROOT=meta-viz/data

INCLUDE_TYPES=all
VALID_FLAG=all

INCLUDE_INVALID=true
METAIS_NODE_TEMPLATE_ALL=groovy/template/node_template_all.groovy
METAIS_NODE_TEMPLATE_VALID_ONLY=groovy/template/node_template_valid_only.groovy

METAIS_REL_TEMPLATE_ALL=groovy/template/relation_template_all.groovy
METAIS_REL_TEMPLATE_VALID_ONLY=groovy/template/relation_template_valid_only.groovy

INTERACTIVE_ATTRIBUTES=true