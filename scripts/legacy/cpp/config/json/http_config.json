{
  "auth": {
    "mode": "oidc_userpass_pkce",
    "required": true,

    "user_env": "METAIS_USER",
    "pass_env": "METAIS_PASS",
    "interactive": true,

    "client_id": "webPortalClient",
    "redirect_path": "/auth-success",
    "scope": "openid",

    "token_prefix": "Bearer ",
    "user_agent": "metais-cpp-fetcher/1.0"
  },

  "timeouts": {
    "connect_seconds": 10,
    "total_seconds": 60
  },

  "retries": {
    "max_attempts": 5,
    "base_delay_ms": 500,
    "max_delay_ms": 8000,
    "jitter_ms": 250,
    "retry_http": [408, 429, 500, 502, 503, 504],
    "retry_curl": ["timeout", "couldnt_connect", "couldnt_resolve_host"]
  },

  "paging": {
    "enabled": true,
    "page_size": 1000,
    "max_pages": 100000,
    "offset_param": "offset",
    "limit_param": "limit"
  }
}